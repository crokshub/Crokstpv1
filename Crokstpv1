        TBypass.Text = "Bypass  -  ON"
        BtnBypass.BackgroundColor3 = C.success
        GBypass.Color = ColorSequence.new(C.success, C.accent2)
    end
end

local function ToggleRag()
    AntiRagdollAtivo = not AntiRagdollAtivo
    if AntiRagdollAtivo then
        TRag.Text = "Anti-Ragdoll  -  ON"
        BtnRag.BackgroundColor3 = C.success
        GRag.Color = ColorSequence.new(C.success, C.accent2)
    else
        TRag.Text = "Anti-Ragdoll  -  OFF"
        BtnRag.BackgroundColor3 = C.off
        GRag.Color = ColorSequence.new(C.off, C.off2)
    end
end

local function ToggleAntiHit()
    AntiHitAtivo = not AntiHitAtivo
    if AntiHitAtivo then
        local hum = Bypass.Fake or (LP.Character and LP.Character:FindFirstChildOfClass("Humanoid"))
        blindarHealth(hum)
        TAH.Text = "Anti-Hit  -  ON"
        BtnAntiHit.BackgroundColor3 = C.success
        GAH.Color = ColorSequence.new(C.success, C.accent2)
    else
        if hitConn then pcall(function() hitConn:Disconnect() end); hitConn = nil end
        TAH.Text = "Anti-Hit  -  OFF"
        BtnAntiHit.BackgroundColor3 = C.off
        GAH.Color = ColorSequence.new(C.off, C.off2)
    end
end

local function ToggleAutoBat()
    AutoBatAtivo = not AutoBatAtivo
    if AutoBatAtivo then
        TAB.Text = "AUTO BAT  -  ON"
        BtnAutoBat.BackgroundColor3 = C.success
        GAB.Color = ColorSequence.new(C.success, C.accent2)
    else
