local AntiHitAtivo = true
local hitConn = nil

local function blindarHealth(hum)
    if not hum then return end
    if hitConn then pcall(function() hitConn:Disconnect() end) end
    local hpMax = hum.MaxHealth
    hitConn = hum.HealthChanged:Connect(function(novo)
        if not AntiHitAtivo then return end
        if novo < hpMax and hum.Health < hpMax then
            pcall(function() hum.Health = hpMax end)
        end
    end)
end

