-- AUTO STEAL — Melhor ovo → galinha → SafeZone
-- ============================================================
local AutoStealLigado = false
local CicloAndando = false
local TemOvo = false
local UidAtual = nil

if net then
    local FEC = net:FindFirstChild("RE/EggWorld/FieldEggCarry")
    if FEC and FEC:IsA("RemoteEvent") then
        FEC.OnClientEvent:Connect(function(dados)
            TemOvo = true
            if type(dados) == "table" and dados.Uid then
                UidAtual = dados.Uid
            end
        end)
    end
    local FED = net:FindFirstChild("RE/EggWorld/FieldEggDrop")
    if FED and FED:IsA("RemoteEvent") then
        FED.OnClientEvent:Connect(function()
            TemOvo = false
            UidAtual = nil
        end)
    end
end

local function PegarMelhorOvo()
    local ovos = ListarOvos()
    if #ovos == 0 then return nil end
    return ovos[1]
end

local function CicloAutoSteal()
    if CicloAndando then return end
    if not AutoStealLigado then return end
    CicloAndando = true

    task.spawn(function()
        addLog("[CICLO] Iniciando...")
        Bypass.Reativar()
        Bypass.Apply(LP.Character)
        task.wait(0.5)

        while AutoStealLigado do
            -- 1. Lista ovos, pega o melhor
            local melhor = PegarMelhorOvo()
            if not melhor then
                StatusLabel.Text = "Nenhum ovo — esperando mapa"
                StatusLabel.TextColor3 = Color3.fromRGB(240, 180, 60)
                addLog("[CICLO] Sem ovos, esperando 5s")
                task.wait(5)
                continue
            end

            addLog("[CICLO] Melhor: " .. tostring(melhor.Category) .. " | " .. tostring(melhor.Area))

            -- 2. TP até o melhor ovo
            StatusLabel.Text = "TP pro melhor ovo..."
            StatusLabel.TextColor3 = Color3.fromRGB(120, 200, 255)
            TeleportarPara(melhor.Pos)
            task.wait(0.5)

            -- 3. Pega o ovo
            StatusLabel.Text = "Pegando ovo..."
            StatusLabel.TextColor3 = Color3.fromRGB(240, 180, 60)
            local pegou = PegarOvoPorUid(melhor.Uid)
            addLog("[CICLO] Pegar: " .. tostring(pegou))

            if pegou then
                -- 4. Espera guardião bater (ovo dropa)
                StatusLabel.Text = "Ovo pego! Esperando guardião..."
                StatusLabel.TextColor3 = Color3.fromRGB(50, 230, 140)

                local t0 = tick()
                while AutoStealLigado and TemOvo and (tick() - t0) < CONFIG.ESPERA_KNOCK do
                    task.wait(0.1)
                end

                if TemOvo then
                    addLog("[CICLO] Guard não bateu (timeout)")
                else
                    addLog("[CICLO] Ovo dropou!")
                end

                -- 5. TP pra SafeZone
                StatusLabel.Text = "TP pra SafeZone..."
                StatusLabel.TextColor3 = Color3.fromRGB(120, 200, 255)
                task.wait(0.3)
                TeleportarPara(CONFIG.SAFEZONE_POS)
                task.wait(1)

                -- 6. Entrega (dropa)
                SoltarOvo()
                addLog("[CICLO] Entregou na SafeZone")
                task.wait(1)
            else
                addLog("[CICLO] Falha ao pegar — próximo")
                task.wait(1)
            end
        end

        StatusLabel.Text = "Ciclo parado"
        StatusLabel.TextColor3 = C.textDim
        CicloAndando = false
    end)
end

