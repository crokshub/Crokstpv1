-- ============================================================
-- PEGAR OVO (por Uid)
-- ============================================================
local function PegarOvoPorUid(uid)
    if not Carry or not uid then return false end
    local ok, r = pcall(function() return Carry:InvokeServer({Uid = uid}) end)
    return ok and r == true
end

local function SoltarOvo()
    if not Drop then return false end
    local ok = pcall(function() Drop:InvokeServer({Reason = "PlayerRequest"}) end)
    return ok
end

-- ============================================================
-- LISTAR OVOS (Snapshot)
-- ============================================================
local function ListarOvos()
    if not Snapshot then return {} end
    local ok, r = pcall(function() return Snapshot:InvokeServer() end)
    if not ok or not r or not r.Records then return {} end
    local ovos = {}
    for _, rec in ipairs(r.Records) do
        if rec.State == "Slot" or rec.State == "Dropped" then
            local pos = rec.BottomCFrame and rec.BottomCFrame.Position
            if pos then
                table.insert(ovos, {
                    Uid = rec.Uid,
                    Category = rec.AssetCategory,
                    Area = rec.AreaId,
                    Scale = rec.AssetScale,
                    Pos = pos,
                    Value = (rec.AssetScale or 1),
                })
            end
        end
    end
    table.sort(ovos, function(a, b) return a.Value > b.Value end)
    return ovos
end

