-- ============================================================
-- BYPASS — Desync Lennon-style (resolve bug do boss)
-- ============================================================
local Bypass = {
    Enabled = true, InProgress = false, Active = false,
    Original = nil, OriginalState = nil, Fake = nil, Char = nil,
    StateConn = nil, DescConn = nil,
}

local function dsSnapshot(h)
    return {
        Archivable = h.Archivable,
        BreakJointsOnDeath = h.BreakJointsOnDeath,
        WalkSpeed = h.WalkSpeed, JumpPower = h.JumpPower,
        JumpHeight = h.JumpHeight, UseJumpPower = h.UseJumpPower,
        HipHeight = h.HipHeight, Health = h.Health,
    }
end

function Bypass.Apply(character)
    if not Bypass.Enabled or Bypass.InProgress then return false end
    if Bypass.Active and Bypass.Fake and Bypass.Fake.Parent then return true end
    Bypass.InProgress = true

    character = character or LP.Character
    if not character then Bypass.InProgress = false; return false end

    local real = character:FindFirstChildOfClass("Humanoid")
    if not real then Bypass.InProgress = false; return false end

    Bypass.Char = character
    Bypass.Original = real
    Bypass.OriginalState = dsSnapshot(real)

    real.Archivable = true
    local fake = real:Clone()
    fake.Name = "Humanoid"
    fake.BreakJointsOnDeath = false
    pcall(function() fake:SetStateEnabled(Enum.HumanoidStateType.Dead, false) end)
    pcall(function() fake:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false) end)
    pcall(function() fake:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false) end)
    pcall(function() fake:SetStateEnabled(Enum.HumanoidStateType.Physics, false) end)
    pcall(function() fake.RequiresNeck = false end)
    fake.Health = fake.MaxHealth

    -- move animator pro fake
    local anim = real:FindFirstChildOfClass("Animator")
    if anim then pcall(function() anim.Parent = fake end) end

    real.Parent = nil
    fake.Parent = character
    fake.PlatformStand = false
    fake.Sit = false
    fake.AutoRotate = true

    Bypass.StateConn = fake.StateChanged:Connect(function(_, new)
        if new == Enum.HumanoidStateType.Ragdoll
           or new == Enum.HumanoidStateType.FallingDown
           or new == Enum.HumanoidStateType.Physics then
            fake.PlatformStand = false
            fake.Sit = false
            pcall(function() fake:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        end
    end)

    pcall(function()
        if Workspace.CurrentCamera then
            Workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
            Workspace.CurrentCamera.CameraSubject = fake
        end
    end)

    Bypass.Fake = fake
    Bypass.Active = true
    Bypass.InProgress = false
    return true
end

function Bypass.Remove()
    if Bypass.InProgress then return end
    Bypass.InProgress = true

    if Bypass.StateConn then pcall(function() Bypass.StateConn:Disconnect() end); Bypass.StateConn = nil end
    if Bypass.DescConn  then pcall(function() Bypass.DescConn:Disconnect()  end); Bypass.DescConn  = nil end

    local char = Bypass.Char or LP.Character
    local real = Bypass.Original
    local fake = Bypass.Fake

    if fake then pcall(function() fake:Destroy() end) end

    if real and char then
        real.Parent = char
        local s = Bypass.OriginalState or {}
        pcall(function()
            real.Archivable         = s.Archivable
            real.BreakJointsOnDeath = s.BreakJointsOnDeath
            real.WalkSpeed          = s.WalkSpeed or real.WalkSpeed
            real.JumpPower          = s.JumpPower or real.JumpPower
            real.JumpHeight         = s.JumpHeight or real.JumpHeight
            real.UseJumpPower       = s.UseJumpPower
            real.HipHeight          = s.HipHeight or real.HipHeight
            real.PlatformStand      = false
            real.AutoRotate         = true
            real.Sit                = false
            real.Health             = math.min(s.Health or real.MaxHealth, real.MaxHealth)
            real:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
        pcall(function()
            if Workspace.CurrentCamera then
                Workspace.CurrentCamera.CameraSubject = real
            end
        end)
    end

    Bypass.Original = nil
    Bypass.OriginalState = nil
    Bypass.Fake = nil
    Bypass.Char = nil
    Bypass.Active = false
    Bypass.InProgress = false
    Bypass.Enabled = true
end

function Bypass.IsActive()
    return Bypass.Active and Bypass.Fake ~= nil and Bypass.Fake.Parent ~= nil
end

function Bypass.Reativar() Bypass.Enabled = true end
_G.CroksBypass = Bypass

