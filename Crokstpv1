-- Copiar Discord
copyBtn.MouseButton1Click:Connect(function()
    local ok = false
    if setclipboard then ok = pcall(setclipboard, DISCORD_LINK)
    elseif toclipboard then ok = pcall(toclipboard, DISCORD_LINK) end

    if ok then
        feedback.Text = "✓ Discord copiado!"
        feedback.TextColor3 = Color3.fromRGB(120, 255, 170)
        copyBtn.Text = "✓ COPIADO!"
        copyBtn.BackgroundColor3 = Color3.fromRGB(50, 210, 100)
        task.delay(2, function()
            feedback.Text = ""
            copyBtn.Text = "📋 COPIAR DISCORD"
            copyBtn.BackgroundColor3 = Color3.fromRGB(200, 30, 30)
        end)
    else
        feedback.Text = "Link: discord.gg/dDqdH8tJdM"
        feedback.TextColor3 = Color3.fromRGB(255, 200, 100)
        task.delay(4, function()
            feedback.Text = ""
        end)
    end
end)

