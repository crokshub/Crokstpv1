-- ============================================================
-- ABRIR / FECHAR
-- ============================================================
local aberto = false

local function abrir()
    if aberto then return end
    aberto = true
    BtnFloat.Visible = false
    Main.Visible = true
    Main.Size = UDim2.new(0,0,0,0)
    Main.Position = UDim2.new(0.5,0,0.5,0)
    TS:Create(Main, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0,280,0,400),
        Position = UDim2.new(0.5,-140,0.5,-200)
    }):Play()
end

local function fechar()
    if not aberto then return end
    aberto = false
    local tw = TS:Create(Main, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0,0,0,0),
        Position = UDim2.new(0.5,0,0.5,0)
    })
    tw:Play()
    tw.Completed:Connect(function()
        Main.Visible = false
        BtnFloat.Visible = true
    end)
end

BtnMin.MouseButton1Click:Connect(fechar)
BtnClose.MouseButton1Click:Connect(function() SG:Destroy() end)

local arr, mov, off = false, false, Vector2.new()
BtnFloat.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        arr = true; mov = false
        off = Vector2.new(i.Position.X - BtnFloat.AbsolutePosition.X,
                          i.Position.Y - BtnFloat.AbsolutePosition.Y)
    end
end)
UIS.InputChanged:Connect(function(i)
    if arr and (i.UserInputType == Enum.UserInputType.MouseMovement
       or i.UserInputType == Enum.UserInputType.Touch) then
        local np = Vector2.new(i.Position.X - off.X, i.Position.Y - off.Y)
        if (np - BtnFloat.AbsolutePosition).Magnitude > 5 then mov = true end
        BtnFloat.Position = UDim2.new(0, np.X, 0, np.Y)
    end
end)
UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
       or i.UserInputType == Enum.UserInputType.Touch then
        if arr and not mov then abrir() end
        arr = false
    end
end)

task.wait(0.5)
abrir()

