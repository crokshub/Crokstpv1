local function PegarOvoProximidade()
    if not fireproximityprompt then return false end
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local melhor, menor = nil, math.huge
    for _, o in ipairs(workspace:GetDescendants()) do
        if o:IsA("ProximityPrompt") then
            local p = o.Parent
            if p and p:IsA("BasePart") then
                local d = (p.Position - hrp.Position).Magnitude
                if d < 50 and d < menor then menor = d; melhor = o end
            end
        end
    end
    if melhor then pcall(function() fireproximityprompt(melhor, 0) end); return true end
    return false
end
-- ============================================================
-- CICLO AUTO STEAL
-- ============================================================
local AutoStealLigado = false
local CicloAndando = false
local TemOvo = false

if Networking then
    local FEC = Networking:FindFirstChild("RE/EggWorld/FieldEggCarry")
    if FEC and FEC:IsA("RemoteEvent") then
        FEC.OnClientEvent:Connect(function() TemOvo = true end)
    end
    local FED = Networking:FindFirstChild("RE/EggWorld/FieldEggDrop")
    if FED and FED:IsA("RemoteEvent") then
        FED.OnClientEvent:Connect(function() TemOvo = false end)
    end
end

local function CicloAutoSteal()
    if CicloAndando then return end
    if not AutoStealLigado then return end
    CicloAndando = true

    task.spawn(function()
        Bypass.Reativar()
        Bypass.Apply(LP.Character)
        task.wait(0.4)

        StatusLabel.Text = "TP pra Forest..."
        StatusLabel.TextColor3 = Color3.fromRGB(120, 200, 255)
        TeleportarPara(CONFIG.FOREST_POS)

        StatusLabel.Text = "Na Forest — pega o ovo"
        StatusLabel.TextColor3 = Color3.fromRGB(240, 180, 60)

        local t0 = tick()
        while AutoStealLigado and (tick() - t0) < 90 do
            if TemOvo then break end
            task.wait(0.1)
        end

        if not TemOvo then
            StatusLabel.Text = "Sem ovo detectado"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            CicloAndando = false
            return
        end

        StatusLabel.Text = "Ovo pego! Esperando guardião..."
        StatusLabel.TextColor3 = Color3.fromRGB(50, 230, 140)

        local tKnock = tick()
        while AutoStealLigado and TemOvo and (tick() - tKnock) < CONFIG.ESPERA_KNOCK do
            task.wait(0.1)
        end

        if not TemOvo then
            StatusLabel.Text = "Ovo dropou! Pegando de novo..."
            StatusLabel.TextColor3 = Color3.fromRGB(240, 180, 60)
            task.wait(1.5)

            local tentativas = 0
            while AutoStealLigado and not TemOvo and tentativas < 30 do
                PegarOvoProximidade()
                task.wait(0.3)
                tentativas = tentativas + 1
            end
        end

        StatusLabel.Text = "TP pra SafeZone..."
        StatusLabel.TextColor3 = Color3.fromRGB(120, 200, 255)
        task.wait(0.3)
        TeleportarPara(CONFIG.SAFEZONE_POS)

        StatusLabel.Text = "Ciclo completo (bypass ON)"
        StatusLabel.TextColor3 = Color3.fromRGB(50, 230, 140)
        CicloAndando = false
    end)
end

