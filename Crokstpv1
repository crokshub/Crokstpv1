    AutoStealLigado = not AutoStealLigado
    if AutoStealLigado then
        TAuto.Text = "AUTO STEAL  -  ON"
        BtnAuto.BackgroundColor3 = C.success
        GAuto.Color = ColorSequence.new(C.success, C.accent2)
        CicloAutoSteal()
    else
        TAuto.Text = "AUTO STEAL  -  OFF"
        BtnAuto.BackgroundColor3 = C.off
        GAuto.Color = ColorSequence.new(C.off, C.off2)
        StatusLabel.Text = "Auto Steal OFF"
    end
end

local function ToggleAntiTrap()
    AntiTrapAtivo = not AntiTrapAtivo
    TAT.Text = AntiTrapAtivo and "Anti-Trap  -  ON" or "Anti-Trap  -  OFF"
    BtnAT.BackgroundColor3 = AntiTrapAtivo and C.success or C.off
    GAT.Color = AntiTrapAtivo and ColorSequence.new(C.success, C.accent2) or ColorSequence.new(C.off, C.off2)
end

local function ToggleAutoBat()
    AutoBatAtivo = not AutoBatAtivo
    TAB.Text = AutoBatAtivo and "AUTO BAT  -  ON" or "AUTO BAT  -  OFF"
    BtnAutoBat.BackgroundColor3 = AutoBatAtivo and C.success or C.off
    GAB.Color = AutoBatAtivo and ColorSequence.new(C.success, C.accent2) or ColorSequence.new(C.off, C.off2)
end

local function ToggleRag()
    AntiRagdollAtivo = not AntiRagdollAtivo
    TRag.Text = AntiRagdollAtivo and "Anti-Ragdoll  -  ON" or "Anti-Ragdoll  -  OFF"
    BtnRag.BackgroundColor3 = AntiRagdollAtivo and C.success or C.off
    GRag.Color = AntiRagdollAtivo and ColorSequence.new(C.success, C.accent2) or ColorSequence.new(C.off, C.off2)
end

local function CopiarLog()
    local texto = table.concat(LOG, "\n")
    local ok = false
    if setclipboard then ok = pcall(setclipboard, texto)
    elseif toclipboard then ok = pcall(toclipboard, texto) end
    if ok then
        TLog.Text = "✓ COPIADO!"
        BtnLog.BackgroundColor3 = C.success
        task.delay(1.5, function()
            TLog.Text = "📋 COPIAR LOG"
            BtnLog.BackgroundColor3 = C.accent
        end)
    else
        TLog.Text = "✗ FALHOU"
        BtnLog.BackgroundColor3 = Color3.fromRGB(240, 80, 80)
        task.delay(1.5, function()
            TLog.Text = "📋 COPIAR LOG"
            BtnLog.BackgroundColor3 = C.accent
        end)
    end
end

BtnAuto.MouseButton1Click:Connect(ToggleAuto)
BtnAT.MouseButton1Click:Connect(ToggleAntiTrap)
BtnAutoBat.MouseButton1Click:Connect(ToggleAutoBat)
BtnRag.MouseButton1Click:Connect(ToggleRag)
BtnLog.MouseButton1Click:Connect(CopiarLog)

-- ABRIR/FECHAR
local aberto = false
local function abrir()
    if aberto then return end
    aberto = true
    BtnFloat.Visible = false
    Main.Visible = true
    Main.Size = UDim2.new(0,0,0,0)
    Main.Position = UDim2.new(0.5,0,0.5,0)
    TS:Create(Main, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0,280,0,360),
        Position = UDim2.new(0.5,-140,0.5,-180)
    }):Play()
end

local function fechar()
    if not aberto then return end
    aberto = false
    local tw = TS:Create(Main, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0,0,0,0),
        Position = UDim2.new(0.5,0,0.5,0)
    })
    tw:Play()
    tw.Completed:Connect(function()
        Main.Visible = false
        BtnFloat.Visible = true
    end)
end

BtnMin.MouseButton1Click:Connect(fechar)
BtnClose.MouseButton1Click:Connect(function() SG:Destroy() end)

local arr, mov, off = false, false, Vector2.new()
BtnFloat.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        arr = true; mov = false
        off = Vector2.new(i.Position.X - BtnFloat.AbsolutePosition.X,
                          i.Position.Y - BtnFloat.AbsolutePosition.Y)
    end
end)
UIS.InputChanged:Connect(function(i)
    if arr and (i.UserInputType == Enum.UserInputType.MouseMovement
       or i.UserInputType == Enum.UserInputType.Touch) then
        local np = Vector2.new(i.Position.X - off.X, i.Position.Y - off.Y)
        if (np - BtnFloat.AbsolutePosition).Magnitude > 5 then mov = true end
        BtnFloat.Position = UDim2.new(0, np.X, 0, np.Y)
    end
end)
UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1
       or i.UserInputType == Enum.UserInputType.Touch then
        if arr and not mov then abrir() end
        arr = false
    end
end)

