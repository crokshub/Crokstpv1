local AutoBatAtivo = false

local function getNearestPlayer()
    local char = LP.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local best, bestDist = nil, CONFIG.BAT_RANGE
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local c = plr.Character
            local h = c and c:FindFirstChild("HumanoidRootPart")
            local hum = c and c:FindFirstChildOfClass("Humanoid")
            if h and hum and hum.Health > 0 then
                local d = (h.Position - hrp.Position).Magnitude
                if d < bestDist then bestDist = d; best = c end
            end
        end
    end
    return best
end

local function tryAttack(target)
    local char = LP.Character
    if not char or not target then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool and tool:FindFirstChild("Handle") then
        pcall(function() tool:Activate() end)
    end
    for _, o in ipairs(target:GetDescendants()) do
        if o:IsA("ProximityPrompt") then
            pcall(function() fireproximityprompt(o, 0) end)
        end
    end
    local net = RS:FindFirstChild("Packages")
    net = net and net:FindFirstChild("Networking")
    if net then
        for _, r in ipairs(net:GetChildren()) do
            if r:IsA("RemoteEvent") and (r.Name:lower():find("hit") or r.Name:lower():find("attack")) then
                pcall(function() r:FireServer(target) end)
            end
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.05)
        if AutoBatAtivo then
            local tgt = getNearestPlayer()
            if tgt then
                tryAttack(tgt)
                task.wait(CONFIG.BAT_CD)
            end
        end
    end
end)

